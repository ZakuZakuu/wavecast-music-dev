# A separately running NetEase-compatible development server.
NETEASE_UPSTREAM_BASE_URL=http://127.0.0.1:3000
NETEASE_UPSTREAM_TIMEOUT_SECONDS=10
# Optional. Use when the upstream is hosted remotely behind a reverse proxy
# that requires Authorization: Bearer <token>.
NETEASE_UPSTREAM_BEARER_TOKEN=

# Optional. The upstream's NetEase login session (full cookie string), sent only
# to the upstream as a Cookie header. Independent of the bearer token above.
NETEASE_UPSTREAM_COOKIE=
